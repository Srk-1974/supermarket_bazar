# Database connection (Postgres example)
# Replace values or set POSTGRES_URL
DB_ENGINE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=supermarketdb
DB_USER=postgres
DB_PASSWORD=postgres
# Optional full URL (overrides host/port/db user):
# POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/supermarketdb

# Other app settings
APP_ENV=development
APP_DEBUG=true
